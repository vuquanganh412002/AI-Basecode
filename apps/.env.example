# apps/.env — required by docker compose. Two ways to create it:
#
#   A) symlink to the backend env (what the team uses locally — one file to edit):
#        ln -s ./backend/.env apps/.env
#      backend/.env already carries every key below.
#
#   B) copy this file, if you prefer apps/.env separate from the backend env:
#        cp apps/.env.example apps/.env
#      Then DELETE COMPOSE_PROJECT_NAME + DENSHIBAN_DB_ROOT_PASSWORD from
#      apps/backend/.env so there is a single source of truth for them.
#
# This file feeds ONLY `${...}` interpolation inside docker-compose.yml (compose
# reads the .env sitting next to the compose file). It does NOT reach the backend
# container: that gets its environment from `env_file: ./backend/.env`.
#
# Six of these have no `:-default` in docker-compose.yml, so leaving them unset
# silently creates a Postgres container with an empty database/user and a MinIO
# container with empty credentials. Copy this file before the first `up`.
#
# Section / key order follows apps/backend/.env.deploy, the canonical ordering
# for every env file in this repo.

# =============================================================================
# Compose
# =============================================================================
COMPOSE_PROJECT_NAME=agrinews   # container / network name prefix

# =============================================================================
# Database (PostgreSQL container init)
# =============================================================================
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=agrinews_dev

# =============================================================================
# Storage (MinIO container init + bucket bootstrap)
# =============================================================================
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=agrinews

# =============================================================================
# 電子版 DB (denshiban-mysql container init + healthcheck)
# =============================================================================
DENSHIBAN_DB_USERNAME=readermanage
DENSHIBAN_DB_PASSWORD=readermanage
DENSHIBAN_DB_NAME=cmsDB
DENSHIBAN_DB_ROOT_PASSWORD=rootpassword
