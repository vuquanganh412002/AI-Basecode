# API のベース URL。ローカル開発は BE の origin をそのまま指定する。
# 空にすると axios-instance が '/api' へフォールバックし、各 wrapper が既に持つ
# '/api/v1/...' と二重化して '/api/api/v1/...' になる（docs/deploy-aws.md
# §トラブルシュート参照）。末尾に '/api' を付けないこと。
VITE_API_BASE_URL=http://localhost:3000
# ブラウザタブのタイトル。index.html の %VITE_APP_TITLE% に build 時展開される。
# 未定義だとプレースホルダがそのまま出るため、必ず値を設定すること。
VITE_APP_TITLE=agrinews
