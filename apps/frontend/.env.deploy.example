# Copy to .env.deploy and fill in for the target environment.
# Read by scripts/deploy-aws.sh on a frontend deploy (--frontend-only or full run).
# Key order mirrors a working .env.deploy — keep them in sync so diffing a real
# deploy file against this template stays readable.
#
# Every key here is DEPLOY-MANAGED: consumed by the deploy script (S3 sync,
# CloudFront invalidation) or baked into the bundle at Vite build time. Nothing
# is injected into a running container — the frontend ships as static files.
#
# Values below are placeholders in the `agn-<env>-…` naming scheme. Replace
# `<env>` (dev / stg / prod) and the AWS-generated IDs with the real ones.

AWS_REGION=ap-northeast-1
# AWS_PROFILE=default

# S3 bucket for static assets (dist/ sync).
FRONTEND_S3_BUCKET=agn-<env>-web-static

# CloudFront invalidation (/*) after the S3 sync. The deploy script runs it ONLY
# when this is set — leaving it commented means viewers keep the previous bundle
# until the CDN TTL expires, so enable it for any environment users actually hit.
#CLOUDFRONT_DISTRIBUTION_ID=EXXXXXXXXXXXXX

# Vite build-time variables (baked into the bundle, not runtime env).
# VITE_API_BASE_URL resolution order in deploy-aws.sh:
#   1. this value, when set
#   2. https://<domain of CLOUDFRONT_DISTRIBUTION_ID>, when that is set
#   3. "/" (same origin) otherwise
# Do NOT append /api — the API wrappers already send /api/v1/...
VITE_API_BASE_URL=https://<frontend-domain>
VITE_APP_TITLE=購読者管理システム
