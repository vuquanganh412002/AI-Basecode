# Copy to .env.deploy and adjust for the target environment.
# Used by scripts/deploy-aws.sh when deploying the frontend (--frontend-only or full deploy).

AWS_REGION=ap-northeast-1
# AWS_PROFILE=default

# S3 bucket for static assets (dist/ sync).
FRONTEND_S3_BUCKET=agn-dev-web-static

# CloudFront invalidation after upload (optional but recommended).
CLOUDFRONT_DISTRIBUTION_ID=E39H7J7LF4EAY7

# Vite build-time variables.
# If VITE_API_BASE_URL is empty, deploy-aws.sh resolves it from CLOUDFRONT_DISTRIBUTION_ID:
#   https://<cloudfront-domain>
# Do NOT include /api — API paths already contain /api/v1/...
# VITE_API_BASE_URL=
VITE_APP_TITLE=agrinews
