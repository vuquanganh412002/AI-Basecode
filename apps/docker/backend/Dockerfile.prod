FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
# JST runtime - install tzdata so TZ=Asia/Tokyo actually shifts dates/logs.
# See .claude/rules/nestjs.md §Timestamp policy.
RUN apk add --no-cache tzdata
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./
# One-off ECS tasks (deploy-aws.sh) run migration:run:prod and seed:sample:prod.
COPY --from=builder --chown=nestjs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nestjs:nodejs /app/src ./src
COPY --from=builder --chown=nestjs:nodejs /app/tsconfig.json ./tsconfig.json
# ECS one-off tasks run seed scripts via ts-node (devDependencies are pruned
# in the builder stage). Install with NODE_ENV=development so npm actually
# lays out ts-node, tsconfig-paths, and typescript under node_modules.
USER root
RUN NODE_ENV=development npm install --no-save \
  ts-node@^10.9.2 \
  tsconfig-paths@^4.2.0 \
  typescript@^6.0.3
USER nestjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/api/v1/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"
CMD ["node", "dist/main"]
