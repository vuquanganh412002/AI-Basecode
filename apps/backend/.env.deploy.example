# Copy to .env.deploy and fill in for the target environment.
# Key order mirrors a working .env.deploy — keep them in sync so diffing a real
# deploy file against this template stays readable.
#
# This single file serves two roles:
#   1. Deploy orchestration — read by scripts/deploy-aws.sh (ECR, ECS, migrations, seed).
#   2. ECS runtime env     — remaining keys are merged into the task definition
#                            as plaintext `environment` entries on deploy.
#
# Three classes of keys, handled differently by scripts/deploy-aws.sh:
#
#   DEPLOY-MANAGED  Consumed by the deploy script itself, never injected into the
#                   container. (DEPLOY_MANAGED_KEYS_DEFAULT in deploy-aws.sh)
#   SECRET-MANAGED  Stripped from plaintext injection — the value comes from AWS
#                   Secrets Manager via the task definition `secrets` block.
#                   Listing one here is dead weight, so they are commented out
#                   below purely as documentation. (SECRET_MANAGED_KEYS_DEFAULT)
#                     DB_USERNAME, DB_PASSWORD, REDIS_PASSWORD, REDIS_AUTH_TOKEN,
#                     SESSION_SECRET, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY,
#                     MAIL_USER, MAIL_PASS,
#                     DENSHIBAN_DB_PASSWORD, DENSHIBAN_DB_COMMON_KEY
#   PLAINTEXT       Everything else — injected as-is into the task definition.
#
# Values below are placeholders in the `agn-<env>-…` naming scheme. Replace
# `<env>` (dev / stg / prod) and the AWS-generated suffixes with the real ones.

# =============================================================================
# Deploy (scripts/deploy-aws.sh — not injected into ECS)
# =============================================================================
AWS_REGION=ap-northeast-1
# AWS_PROFILE=default

BACKEND_ECR_REPOSITORY=agn-<env>-ecr-backend
ECS_CLUSTER=agn-<env>-ecs-cluster
ECS_SERVICE=agn-<env>-back-ecs-svc
ECS_TASK_DEFINITION=agn-<env>-back-ecs-task
BACKEND_CONTAINER_NAME=backend
# S3 bucket holding the seed:dev "once" marker object (may match FRONTEND_S3_BUCKET).
BACKEND_SEED_DEV_S3_BUCKET=agn-<env>-web-static

# Run TypeORM migrations via an ECS one-off task before the service rollout.
# BACKEND_RUN_MIGRATIONS=1
# Run seed:prod + seed:dev:prod. Values: once | always | never
# BACKEND_RUN_SEED_DEV=once
# BACKEND_SEED_DEV_MARKER_KEY=.deploy/<cluster>-backend-seed-dev.done

# =============================================================================
# App
# =============================================================================
# NODE_ENV drives the production secret guard: only `production` makes
# configuration.ts run assertProductionSecrets(), which refuses to boot when
# SESSION_SECRET / DB_PASSWORD / STORAGE_* are unset or still at dev defaults.
# Keep `development` for the agn-dev environment; use `staging` / `production`
# for those environments so the guard actually protects them.
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://test.agrinews-manage.example
FRONTEND_URL=https://test.agrinews-manage.example
TZ=Asia/Tokyo
# Trusted reverse-proxy hops for req.ip. CloudFront→ALB→ECS = 2 (the default,
# so it only needs setting when the edge topology differs). A wrong value makes
# rate-limiting bucket every client together and audit logs record the proxy IP.
# TRUST_PROXY_HOPS=2
# log-cleanup batch: delete t_log / t_login_log older than N years. Default 5.
# LOG_RETENTION_YEARS=5

# =============================================================================
# Database (Aurora PostgreSQL)
# =============================================================================
# DB_USERNAME / DB_PASSWORD are SECRET-MANAGED (RDS master secret) — the deploy
# script strips them, so any value here is dead. Do not re-add them.
DB_HOST=agn-<env>-db-cluster.cluster-xxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=
# Aurora/RDS require TLS (pg_hba rejects non-encrypted connections).
DB_SSL=true

# =============================================================================
# Auth: Session (Redis-backed)
# =============================================================================
# REDIS_PASSWORD arrives from Secrets Manager as REDIS_AUTH_TOKEN, and
# SESSION_SECRET via var.backend_secret_arns — both SECRET-MANAGED.
REDIS_HOST=master.agn-<env>-redis.xxxxxx.apne1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TLS=true
REDIS_URL=rediss://master.agn-<env>-redis.xxxxxx.apne1.cache.amazonaws.com:6379

SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=86400
# Optional: isolate keys when several environments share one Redis.
# REDIS_KEY_PREFIX=

# =============================================================================
# Storage (S3 app uploads — ECS uses the task IAM role)
# =============================================================================
# No STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY: the S3 client falls back to the
# ECS task role. Both are SECRET-MANAGED and stripped anyway.
# STORAGE_ENDPOINT / STORAGE_PUBLIC_ENDPOINT stay unset on AWS — they exist for
# the local MinIO setup, where the browser cannot resolve the Docker hostname.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=agn-<env>-app-s3-storage
STORAGE_REGION=ap-northeast-1

# =============================================================================
# Mail (SES SMTP — credentials in secret agn-<env>-ses-smtp)
# =============================================================================
# MAIL_USER / MAIL_PASS are SECRET-MANAGED (the SES SMTP credential pair).
MAIL_PROVIDER=ses
MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
MAIL_PORT=587
MAIL_FROM=noreply@<verified-ses-domain>
MAIL_REGION=ap-northeast-1
# SES configuration set — attributes outbound mail so CloudWatch metrics and
# SNS bounce/complaint events fire.
MAIL_CONFIGURATION_SET=agn-<env>-ses-config
# Sender display name: "AGRINEWS" <noreply@…>. Default AGRINEWS; empty = address only.
# MAIL_FROM_NAME=AGRINEWS

# =============================================================================
# 電子版 DB (customer "電子版" system, read-only, MySQL)
# =============================================================================
# 顧客システム「電子版」のDBへの副接続。メイン業務DB(PostgreSQL, DB_* 上)とは別物。
# まずは検証環境(verification)で疎通確認 → 本番は DENSHIBAN_DB_* を ECS task
# definition / AWS Secrets Manager から注入する。
# 非シークレット（plaintext で task definition に注入される）
DENSHIBAN_DB_ENABLED=false
DENSHIBAN_DB_HOST=cmsdb-<env>-read.xxxxxxxx.ap-northeast-1.rds.amazonaws.com
DENSHIBAN_DB_PORT=3306
DENSHIBAN_DB_USERNAME=
DENSHIBAN_DB_NAME=                 # 未指定可（接続・SELECT 1 は通る）
DENSHIBAN_DB_SSL=true
# DENSHIBAN_DB_PASSWORD   → SECRET-MANAGED (do NOT put here)
# DENSHIBAN_DB_COMMON_KEY → SECRET-MANAGED (do NOT put here)

DENSHIBAN_API_URL=https://<denshiban-host>/readermanage/updateUserInfo
DENSHIBAN_PUSH_ENABLED=false
# dokusya-sync batch: full reconcile (ignores the watermark, scans every row).
# Set per EventBridge rule for the nightly run, not in the service task def.
# DENSHIBAN_FULL_SYNC=false
