# Copy to .env.deploy and adjust for the target environment.
#
# This single file serves two roles:
#   1. Deploy orchestration — read by scripts/deploy-aws.sh (ECR, ECS, migrations, seed).
#   2. ECS runtime env     — non-secret keys merged into the task definition on deploy.
#
# Keys in the "Deploy" section below are NEVER injected into the ECS container.
# Secret values (DB_PASSWORD, SESSION_SECRET, …) belong in AWS Secrets Manager;
# leave placeholders here — the deploy script skips them for plaintext injection.

# =============================================================================
# Deploy (scripts/deploy-aws.sh only — not injected into ECS)
# =============================================================================
AWS_REGION=ap-northeast-1
# AWS_PROFILE=default

BACKEND_ECR_REPOSITORY=
ECS_CLUSTER=
ECS_SERVICE=
# ECS_TASK_DEFINITION=
# BACKEND_CONTAINER_NAME=backend

# S3 bucket for seed:dev "once" marker object (can match FRONTEND_S3_BUCKET).
BACKEND_SEED_DEV_S3_BUCKET=

# Run TypeORM migrations via ECS one-off task before service rollout (default: on).
# BACKEND_RUN_MIGRATIONS=1
# Run seed:prod + seed:dev:prod once per environment. Values: once | always | never
# BACKEND_RUN_SEED_DEV=once
# BACKEND_SEED_DEV_MARKER_KEY=.deploy/<cluster>-backend-seed-dev.done

# =============================================================================
# App (ECS runtime)
# =============================================================================
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=
FRONTEND_URL=
LOCAL_DOMAIN=
TZ=Asia/Tokyo

# =============================================================================
# Database (Aurora PostgreSQL)
# =============================================================================
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# =============================================================================
# 電子版 DB (customer "電子版" system, read-only, MySQL)
# =============================================================================
# 非シークレットのみ plaintext で注入。PASSWORD / COMMON_KEY は AWS Secrets
# Manager 管理（deploy-aws.sh の SECRET_MANAGED_KEYS で plaintext をスキップ、
# Terraform が secrets ブロックで注入）— ここには書かない。
DENSHIBAN_DB_ENABLED=true
DENSHIBAN_DB_HOST=                 # 検証: cmsdb-dev-read...rds.amazonaws.com
DENSHIBAN_DB_PORT=3306
DENSHIBAN_DB_USERNAME=
DENSHIBAN_DB_NAME=                 # 未指定可（接続・SELECT 1 は通る）
DENSHIBAN_DB_SSL=true
# DENSHIBAN_DB_PASSWORD   → Secrets Manager (do NOT put here)
# DENSHIBAN_DB_COMMON_KEY → Secrets Manager (do NOT put here)

# =============================================================================
# Auth: Session (HTTP-only Cookie, Redis-backed)
# =============================================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
# REDIS_URL=rediss://<elasticache-host>:6379
SESSION_COOKIE_NAME=session_id
SESSION_SECRET=
SESSION_TTL_SECONDS=86400

# =============================================================================
# Storage (S3)
# =============================================================================
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=ap-northeast-1

# =============================================================================
# Mail (SES)
# =============================================================================
MAIL_PROVIDER=ses
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@agrinews.jp
MAIL_REGION=ap-northeast-1
