{
  "name": "agrinews-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pg": "REAL_PG=1 jest test/integration",
    "test:e2e": "jest --config ./jest-e2e.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "swagger:export": "ts-node -r tsconfig-paths/register src/swagger-export.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "seed:prod": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "seed:dev": "ts-node -r tsconfig-paths/register scripts/seed-dev.ts",
    "seed:dev:prod": "ts-node -r tsconfig-paths/register scripts/seed-dev.ts",
    "dokusya:sync:dev": "ts-node -r tsconfig-paths/register src/batch/dokusya-sync.main.ts",
    "dokusya:sync:prod": "node dist/batch/dokusya-sync.main.js",
    "tanka:expire:dev": "ts-node -r tsconfig-paths/register src/batch/tanka-expire.main.ts",
    "tanka:expire:prod": "node dist/batch/tanka-expire.main.js",
    "log:cleanup:dev": "ts-node -r tsconfig-paths/register src/batch/log-cleanup.main.ts",
    "log:cleanup:prod": "node dist/batch/log-cleanup.main.js",
    "file:cleanup:dev": "ts-node -r tsconfig-paths/register src/batch/file-cleanup.main.ts",
    "file:cleanup:prod": "node dist/batch/file-cleanup.main.js",
    "dokusya:apply-due:dev": "ts-node -r tsconfig-paths/register src/batch/dokusya-apply-due.main.ts",
    "dokusya:apply-due:prod": "node dist/batch/dokusya-apply-due.main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/client-ses": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dayjs": "^1.11.10",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "minio": "^8.0.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "pdfmake": "^0.2.23",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "ioredis-mock": "^8.9.0",
    "jest": "^30.3.0",
    "pg-mem": "^3.0.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "multer": "^2.2.0"
  }
}
