{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "lib": ["ES2022"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    // tsBuildInfo を dist 配下に置く。nest-cli の `deleteOutDir: true` が dist を
    // 消すとき一緒に削除されるので、「dist は消えたが tsbuildinfo は残る」状態に
    // ならない。これがあると incremental で tsc が「ビルド済み」と誤認して JS を
    // emit せず、dist/main.js が生成されない → `node dist/main` が起動失敗する
    // （`nest start --watch` が SIGTERM でビルド中断した後に発生していた）。
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    }
  },
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
