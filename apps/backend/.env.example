# === App ===
NODE_ENV=development          # development | staging | production
PORT=3000
ALLOWED_ORIGINS=              # Comma-separated origins (e.g., https://agrinews.jp,http://localhost)
FRONTEND_URL=                 # SPA base URL — used by BE for absolute links in emails (password reset).
                              # Dev: http://localhost:5173, Prod: https://agrinews.jp
COMPOSE_PROJECT_NAME=agrinews
LOCAL_DOMAIN=agrinews.jp
TZ=Asia/Tokyo                 # JST 運用 — see .claude/rules/nestjs.md §Timestamp policy

# === Database ===
DB_HOST=                      # Docker: postgres, AWS: RDS endpoint
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# === Auth: Session (HTTP-only Cookie, Redis-backed) ===
# Local dev: Redis runs as docker-compose service "redis".
# Production (AWS): set REDIS_URL to the ElastiCache primary endpoint and
# enable TLS when the cluster has in-transit encryption.
REDIS_HOST=redis              # Docker service name (dev); leave blank in prod if using REDIS_URL
REDIS_PORT=6379
REDIS_PASSWORD=               # ElastiCache auth token if enabled
REDIS_TLS=false               # true when using rediss:// / ElastiCache TLS
# REDIS_URL=                  # Alternative: full connection string (overrides host/port)
# REDIS_KEY_PREFIX=           # Optional: isolate keys when sharing Redis across envs
SESSION_COOKIE_NAME=session_id
SESSION_SECRET=               # 32+ byte random; in prod load from AWS Secrets Manager
SESSION_TTL_SECONDS=86400     # 24h sliding window

# === Storage ===
STORAGE_PROVIDER=             # minio (local) | s3 (AWS)
STORAGE_ENDPOINT=             # MinIO: http://minio:9000, S3: leave empty
STORAGE_PUBLIC_ENDPOINT=      # MinIO dev: http://localhost:9000 (browser-facing rewrite for presigned URLs); prod: leave empty (S3 host used)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=ap-northeast-1

# === Mail ===
MAIL_PROVIDER=                # smtp (local) | ses (AWS)
MAIL_HOST=                    # Mailhog: mailhog, SES: leave empty
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@agrinews.jp
MAIL_REGION=ap-northeast-1    # SES region

# === Initial admin seed (only used by `npm run seed`, NOT runtime) ===
# Read directly by apps/backend/scripts/seed.ts to bootstrap the first
# NICHINO_ADMIN account. Standalone CLI script — does NOT go through
# ConfigService. Leave unset locally to use sensible defaults; in
# staging/prod export real values before running the seed once.
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=          # Must be a real address — used for password reset
INITIAL_ADMIN_PASSWORD=       # 12+ chars; if unset, the seed script generates + prints once
