# Copy to .env — the defaults below are the working local (docker-compose) setup,
# so a fresh clone runs without edits.
#
# Section / key order follows .env.deploy, which is the canonical ordering for
# every backend env file. Keep all three aligned so diffing local against a
# deployed config stays readable.
#
# This file is loaded twice: as docker-compose `env_file` for the backend
# container, and by ConfigModule when running `npm run start:dev` outside Docker.
# Deploy-time keys (ECR / ECS / S3 targets) live in .env.deploy.example instead.
#
# Commented-out keys are optional — the value shown is the code default from
# src/config/configuration.ts. Uncomment only to override.

# =============================================================================
# App
# =============================================================================
NODE_ENV=development          # local | development | staging | production
PORT=3000
# Comma-separated CORS origins. Must list every origin the SPA is served from —
# the session cookie is rejected otherwise.
ALLOWED_ORIGINS=http://localhost:5173
# SPA base URL — used by the BE for absolute links in mail (password reset).
# FRONTEND_URL=http://localhost:5173
TZ=Asia/Tokyo                 # JST 運用 — see .claude/rules/nestjs.md §Timestamp policy
# Trusted reverse-proxy hops for req.ip. Default 2 targets CloudFront→ALB→ECS;
# locally there is no proxy, so 0 is the accurate value (affects rate-limit
# bucketing and the client IP recorded in audit logs).
# TRUST_PROXY_HOPS=0
# log-cleanup batch: delete t_log / t_login_log older than N years.
# LOG_RETENTION_YEARS=5

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=postgres              # Docker service name; AWS: RDS endpoint
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres          # prod: AWS Secrets Manager — booting with this value fails
DB_NAME=agrinews_dev
# Local Docker postgres has no certificate. MUST be true on RDS/Aurora —
# managed Postgres rejects non-TLS connections (pg_hba "no encryption").
DB_SSL=false

# =============================================================================
# Auth: Session (HTTP-only Cookie, Redis-backed)
# =============================================================================
REDIS_HOST=redis              # Docker service name; leave blank in prod if using REDIS_URL
REDIS_PORT=6379
REDIS_PASSWORD=               # ElastiCache auth token if enabled
# REDIS_AUTH_TOKEN=           # Alias for REDIS_PASSWORD — ECS/Terraform expose the
                              # ElastiCache token under this name. Config accepts
                              # either (REDIS_PASSWORD wins when both are set).
REDIS_TLS=false               # true for rediss:// / ElastiCache in-transit TLS
# REDIS_URL=rediss://<elasticache-host>:6379   # overrides host/port when set

SESSION_COOKIE_NAME=session_id
SESSION_SECRET=dev-session-secret-please-rotate-in-production-xxxxx
                              # prod: 32+ byte random from AWS Secrets Manager.
                              # Booting production with a dev value is refused.
SESSION_TTL_SECONDS=86400     # 24h sliding window
# REDIS_KEY_PREFIX=           # isolate keys when sharing one Redis across envs

# =============================================================================
# Storage (MinIO — local)
# =============================================================================
STORAGE_PROVIDER=minio        # minio (local) | s3 (AWS — falls back to the ECS task role)
STORAGE_ENDPOINT=http://minio:9000
# Browser-facing host used to rewrite presigned URLs returned to the FE. The BE
# container reaches MinIO via Docker DNS (`minio:9000`); the browser needs the
# host-mapped port. Leave unset on AWS — the real S3 host is used.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin      # prod: Secrets Manager, or omit to use the task role
STORAGE_SECRET_KEY=minioadmin123   # same
STORAGE_BUCKET=agrinews
STORAGE_REGION=ap-northeast-1

# =============================================================================
# Mail (Mailhog — local)
# =============================================================================
# Provider defaults by NODE_ENV: `local` → SMTP/Mailhog, anything else → SES.
# docker-compose runs NODE_ENV=development, so it sets MAIL_PROVIDER=smtp
# explicitly to keep using Mailhog.
MAIL_PROVIDER=smtp            # (override) empty = decide by NODE_ENV | smtp | ses
MAIL_HOST=mailhog             # Mailhog service host; ignored in SES mode
MAIL_PORT=1025                # Mailhog: 1025 / SES SMTP: 587
MAIL_USER=                    # empty for Mailhog; SES SMTP credential in prod
MAIL_PASS=                    # same
MAIL_FROM=noreply@agrinews.jp # SES requires an address on the verified domain
# MAIL_FROM_NAME=AGRINEWS     # sender display name → "AGRINEWS" <noreply@…>.
                              # Empty sends the address only.
# MAIL_REGION=ap-northeast-1  # SES only
# MAIL_CONFIGURATION_SET=     # SES only: agn-<env>-ses-config. Attributes mail to
                              # the set so CloudWatch metrics + SNS bounce /
                              # complaint events fire. Empty = no configuration set.

# =============================================================================
# 電子版 DB（ローカル擬似 MySQL: denshiban-mysql コンテナ）
# =============================================================================
# dokusya-sync バッチが読み取る顧客「電子版」DB のローカルモック。本番/検証は
# DENSHIBAN_DB_* を ECS task definition / AWS Secrets Manager から注入する。
DENSHIBAN_DB_ENABLED=true     # false で副接続を完全にスキップ（接続情報未確定の環境）
DENSHIBAN_DB_HOST=denshiban-mysql   # 検証/本番: cmsdb-<env>-read….rds.amazonaws.com
DENSHIBAN_DB_PORT=3306        # MySQL
DENSHIBAN_DB_USERNAME=readermanage  # 読み取り専用ユーザー
DENSHIBAN_DB_PASSWORD=readermanage  # 本番は Secrets Manager から注入
DENSHIBAN_DB_NAME=cmsDB       # 未指定可（接続・SELECT 1 は通る）
DENSHIBAN_DB_SSL=false        # RDS(検証/本番)は true

# =============================================================================
# 電子版 会員情報更新API (updateUserInfo)
# =============================================================================
# ローカル: 擬似デモ denshiban-demo(別リポジトリ, localhost:4000) を指す。cloud を
#   Docker で動かす場合はコンテナから見て host.docker.internal を使う。
# 本番(AWS): 顧客提供の実 API URL に「差し替えるだけ」でよい（コード変更不要）。
DENSHIBAN_API_URL=http://host.docker.internal:4000/readermanage/updateUserInfo
# 電子版共有の共通キー。デモの DENSHIBAN_API_KEY と一致させる。本番は Secrets Manager。
DENSHIBAN_DB_COMMON_KEY=
# cloud → 電子版 push(会員情報の反映) の有効化。false = push せず cloud 書込のみ。
DENSHIBAN_PUSH_ENABLED=false
# dokusya-sync バッチ: 全件リコンサイル(夜間)。true で watermark 無視の全件走査。
# 通常(10分毎)は false=増分。EventBridge の夜間ルールだけ true を渡す。
# DENSHIBAN_FULL_SYNC=false

# =============================================================================
# CLI-only — read directly by scripts, never through ConfigService
# =============================================================================
# `npm run seed` — bootstraps the first NICHINO_ADMIN account (apps/backend/scripts/seed.ts).
# Leave unset locally for sensible defaults; export real values before seeding stg/prod.
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=          # must be a real address — used for password reset
INITIAL_ADMIN_PASSWORD=       # 12+ chars; if unset the script generates + prints one
# `npm run swagger:export` — output path for the generated OpenAPI JSON.
# SWAGGER_OUT=                # default: apps/backend/swagger.json

# =============================================================================
# NOT read from this file — belongs in apps/.env (next to docker-compose.yml)
# =============================================================================
# docker-compose resolves ${...} interpolation from apps/.env only. Setting these
# here does nothing: this file is an `env_file`, which just injects variables into
# the backend container.
#   COMPOSE_PROJECT_NAME=agrinews        # container / network name prefix
#   DENSHIBAN_DB_ROOT_PASSWORD=rootpassword  # denshiban-mysql root pw + healthcheck
