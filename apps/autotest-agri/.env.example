# Test environment — copy to .env.test and fill in values

# App under test (Docker nginx)
BASE_URL=https://localhost
API_BASE_URL=https://localhost/api/v1

# Test database (postgres-test service in docker-compose)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=agrinews_test
TEST_DB_USERNAME=agrinews_test
TEST_DB_PASSWORD=agrinews_test

# Test Redis (redis-test service in docker-compose)
TEST_REDIS_URL=redis://localhost:6380

# Test accounts (seeded by scripts/seed-test-data.ts)
TEST_ADMIN_EMAIL=nichino_admin@test.agrinews.jp
TEST_ADMIN_PASSWORD=Test1234!
TEST_CHUOKAI_EMAIL=chuokai@test.agrinews.jp
TEST_CHUOKAI_PASSWORD=Test1234!
TEST_JA_HONTEN_EMAIL=ja_honten@test.agrinews.jp
TEST_JA_HONTEN_PASSWORD=Test1234!
TEST_JA_KANRI_EMAIL=ja_kanri@test.agrinews.jp
TEST_JA_KANRI_PASSWORD=Test1234!

# Playwright
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_RETRIES=1
