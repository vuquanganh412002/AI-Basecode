# === App ===
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://__PROJECT__.local,http://localhost,http://localhost:5173
COMPOSE_PROJECT_NAME=__PROJECT__
LOCAL_DOMAIN=__PROJECT__.local

# === Database ===
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=__PROJECT___dev

# === Auth: Session (HTTP-only Cookie, Redis-backed) ===
# Local dev: Redis runs in docker-compose as service "redis".
# Production (AWS): set REDIS_URL to the ElastiCache primary endpoint
#                   and REDIS_TLS=true if in-transit encryption is enabled.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# REDIS_URL=rediss://<elasticache-host>:6379   # prod override
SESSION_COOKIE_NAME=session_id
SESSION_SECRET=dev-session-secret-please-rotate-in-production-xxxxx
SESSION_TTL_SECONDS=86400

# === Storage (MinIO — local) ===
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=__PROJECT__
STORAGE_REGION=ap-northeast-1

# === Mail (Mailhog — local) ===
MAIL_PROVIDER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@__PROJECT__.local
