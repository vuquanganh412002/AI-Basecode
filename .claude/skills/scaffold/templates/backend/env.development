# === App ===
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://__PROJECT__.local,http://localhost,http://localhost:5173
COMPOSE_PROJECT_NAME=__PROJECT__
LOCAL_DOMAIN=__PROJECT__.local

# === Database ===
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=__PROJECT___dev

# === JWT (DEVELOPMENT ONLY) ===
JWT_PRIVATE_KEY_PATH=/app/certs/dev-private.pem
JWT_PUBLIC_KEY_PATH=/app/certs/dev-public.pem
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# === Storage (MinIO — local) ===
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=__PROJECT__
STORAGE_REGION=ap-northeast-1

# === Mail (Mailhog — local) ===
MAIL_PROVIDER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@__PROJECT__.local
